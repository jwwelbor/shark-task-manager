{
  "name": "basic",
  "description": "Simple workflow for solo developers",
  "status_metadata": {
    "todo": {
      "color": "gray",
      "phase": "planning",
      "progress_weight": 0,
      "responsibility": "none",
      "blocks_feature": false,
      "description": "Task not started"
    },
    "in_progress": {
      "color": "yellow",
      "phase": "development",
      "progress_weight": 0.5,
      "responsibility": "agent",
      "blocks_feature": false,
      "description": "Work in progress"
    },
    "completed": {
      "color": "green",
      "phase": "done",
      "progress_weight": 1.0,
      "responsibility": "none",
      "blocks_feature": false,
      "description": "Task finished"
    },
    "blocked": {
      "color": "red",
      "phase": "any",
      "progress_weight": 0,
      "responsibility": "none",
      "blocks_feature": true,
      "description": "Blocked by external dependency"
    }
  },
  "status_flow": {
    "todo": ["in_progress", "blocked"],
    "in_progress": ["completed", "blocked"],
    "completed": [],
    "blocked": ["todo", "in_progress"]
  },
  "special_statuses": {
    "_start_": ["todo"],
    "_complete_": ["completed"]
  },
  "status_flow_version": "1.0",
  "color_enabled": true,
  "bug_workflow": {
    "status_flow": {
      "reported": ["triaged", "duplicate", "wont_fix"],
      "triaged": ["in_fix", "wont_fix", "duplicate"],
      "in_fix": ["in_verification", "triaged"],
      "in_verification": ["resolved", "in_fix"],
      "resolved": [],
      "wont_fix": ["triaged"],
      "duplicate": []
    },
    "status_metadata": {
      "reported": {"color": "red", "description": "Bug reported, awaiting triage", "phase": "planning", "progress_weight": 0},
      "triaged": {"color": "yellow", "description": "Bug triaged, ready for fix", "phase": "planning", "progress_weight": 0.2},
      "in_fix": {"color": "blue", "description": "Fix in progress", "phase": "development", "progress_weight": 0.5},
      "in_verification": {"color": "cyan", "description": "Fix applied, awaiting verification", "phase": "review", "progress_weight": 0.8},
      "resolved": {"color": "green", "description": "Bug verified as fixed", "phase": "done", "progress_weight": 1.0},
      "wont_fix": {"color": "gray", "description": "Bug will not be fixed", "phase": "done", "progress_weight": 1.0},
      "duplicate": {"color": "gray", "description": "Bug is a duplicate", "phase": "done", "progress_weight": 1.0}
    },
    "special_statuses": {
      "_start_": ["reported"],
      "_complete_": ["resolved", "wont_fix", "duplicate"]
    }
  },
  "change_workflow": {
    "status_flow": {
      "proposed": ["approved", "declined"],
      "approved": ["in_progress", "declined"],
      "in_progress": ["completed", "approved"],
      "completed": [],
      "declined": ["proposed"]
    },
    "status_metadata": {
      "proposed": {"color": "yellow", "description": "Change proposed, awaiting approval", "phase": "planning", "progress_weight": 0},
      "approved": {"color": "cyan", "description": "Change approved, ready to implement", "phase": "planning", "progress_weight": 0.2},
      "in_progress": {"color": "blue", "description": "Change implementation in progress", "phase": "development", "progress_weight": 0.5},
      "completed": {"color": "green", "description": "Change completed", "phase": "done", "progress_weight": 1.0},
      "declined": {"color": "red", "description": "Change declined", "phase": "done", "progress_weight": 1.0}
    },
    "special_statuses": {
      "_start_": ["proposed"],
      "_complete_": ["completed", "declined"]
    }
  }
}
