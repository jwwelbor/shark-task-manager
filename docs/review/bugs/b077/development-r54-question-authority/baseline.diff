diff --git a/internal/testcapture/draining_pipe.go b/internal/testcapture/draining_pipe.go
new file mode 100644
index 0000000000000000000000000000000000000000..a0ee7d5e9bbfebd425acc4ba5a7bc16bf7fe6e93
--- /dev/null
+++ b/internal/testcapture/draining_pipe.go
@@ -0,0 +1,69 @@
+// Package testcapture provides safe process-stream capture primitives for
+// tests that need to read captured output after the command finishes.
+package testcapture
+
+import (
+	"bytes"
+	"io"
+	"os"
+	"sync"
+)
+
+// NewDrainingPipe returns a reader for captured output and a writer that can
+// be assigned to os.Stdout or os.Stderr. It starts draining the pipe before
+// returning, so the producer cannot block when it writes more than the
+// operating system's pipe buffer. Close the writer before reading the result.
+//
+// This is for post-run output assertions. Tests that must observe output while
+// the producer is still running should use an explicit streaming reader.
+func NewDrainingPipe() (io.ReadCloser, *os.File, error) {
+	pipeReader, writer, err := os.Pipe()
+	if err != nil {
+		return nil, nil, err
+	}
+
+	var captured bytes.Buffer
+	copyDone := make(chan error, 1)
+	go func() {
+		_, copyErr := io.Copy(&captured, pipeReader)
+		closeErr := pipeReader.Close()
+		if copyErr == nil {
+			copyErr = closeErr
+		}
+		copyDone <- copyErr
+	}()
+
+	return &drainedReader{
+		buffer: &captured,
+		done:   copyDone,
+	}, writer, nil
+}
+
+type drainedReader struct {
+	buffer *bytes.Buffer
+	done   <-chan error
+
+	once      sync.Once
+	reader    *bytes.Reader
+	copyError error
+}
+
+func (r *drainedReader) waitForDrain() {
+	r.once.Do(func() {
+		r.copyError = <-r.done
+		r.reader = bytes.NewReader(r.buffer.Bytes())
+	})
+}
+
+func (r *drainedReader) Read(p []byte) (int, error) {
+	r.waitForDrain()
+	if r.copyError != nil {
+		return 0, r.copyError
+	}
+	return r.reader.Read(p)
+}
+
+func (r *drainedReader) Close() error {
+	r.waitForDrain()
+	return r.copyError
+}
diff --git a/internal/testcapture/draining_pipe_test.go b/internal/testcapture/draining_pipe_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..986f9b72f03faa9685229aa6dbaacafb2058007f
--- /dev/null
+++ b/internal/testcapture/draining_pipe_test.go
@@ -0,0 +1,153 @@
+package testcapture
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestNewDrainingPipeCapturesOutputBeyondPipeBuffer(t *testing.T) {
+	reader, writer, err := NewDrainingPipe()
+	require.NoError(t, err)
+
+	originalStdout := os.Stdout
+	os.Stdout = writer
+	t.Cleanup(func() {
+		os.Stdout = originalStdout
+		_ = writer.Close()
+		_ = reader.Close()
+	})
+
+	// Two mebibytes exceeds the pipe buffers used by the supported platforms.
+	// The concurrent drain must let this synchronous write finish before the
+	// test attempts to read from the returned reader.
+	want := strings.Repeat("capture", (2<<20)/len("capture"))
+	_, writeErr := io.WriteString(os.Stdout, want)
+	require.NoError(t, writeErr)
+	require.NoError(t, writer.Close())
+	os.Stdout = originalStdout
+
+	got, err := io.ReadAll(reader)
+	require.NoError(t, err)
+	require.Equal(t, want, string(got))
+}
+
+func TestStdioPipeCapturesUseDrainingHelper(t *testing.T) {
+	root := repositoryRoot(t)
+	streamingCaptures := map[string]string{
+		"internal/runner/liveness_test.go:captureStderrLines":                             "the liveness helper parses stderr while the child is still running",
+		"tests/contracts/e40_i03_liveness_contract_test.go:TestTC001_I03LivenessContract": "the contract checks liveness output before the child exits",
+	}
+	seenStreamingCaptures := make(map[string]bool, len(streamingCaptures))
+
+	err := filepath.WalkDir(root, func(path string, entry os.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if entry.IsDir() {
+			switch entry.Name() {
+			case ".git", ".worktrees", ".claude", "vendor", "node_modules":
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if !strings.HasSuffix(path, "_test.go") {
+			return nil
+		}
+
+		file, parseErr := parser.ParseFile(token.NewFileSet(), path, nil, 0)
+		if parseErr != nil {
+			return parseErr
+		}
+		relative, relErr := filepath.Rel(root, path)
+		if relErr != nil {
+			return relErr
+		}
+		relative = filepath.ToSlash(relative)
+		for _, declaration := range file.Decls {
+			function, ok := declaration.(*ast.FuncDecl)
+			if !ok || function.Body == nil {
+				continue
+			}
+			hasPipe, hasStdioRedirect, hasReaderGoroutine, hasConcurrentRead := inspectCaptureFunction(function)
+			if !hasPipe || !hasStdioRedirect {
+				continue
+			}
+
+			key := relative + ":" + function.Name.Name
+			if _, allowed := streamingCaptures[key]; !allowed {
+				t.Errorf("%s redirects process output through os.Pipe; use NewDrainingPipe for post-run capture", key)
+				continue
+			}
+			seenStreamingCaptures[key] = true
+			if !hasReaderGoroutine || !hasConcurrentRead {
+				t.Errorf("%s is an approved streaming capture and must keep a concurrent reader", key)
+			}
+		}
+		return nil
+	})
+	require.NoError(t, err)
+	for key := range streamingCaptures {
+		require.True(t, seenStreamingCaptures[key], "streaming capture allowlist entry must exist")
+	}
+}
+
+func repositoryRoot(t *testing.T) string {
+	t.Helper()
+	current, err := os.Getwd()
+	require.NoError(t, err)
+	for {
+		if _, err := os.Stat(filepath.Join(current, "go.mod")); err == nil {
+			return current
+		}
+		parent := filepath.Dir(current)
+		require.NotEqual(t, current, parent, "could not find repository root from working directory")
+		current = parent
+	}
+}
+
+func inspectCaptureFunction(function *ast.FuncDecl) (hasPipe, hasStdioRedirect, hasReaderGoroutine, hasConcurrentRead bool) {
+	ast.Inspect(function.Body, func(node ast.Node) bool {
+		switch node := node.(type) {
+		case *ast.CallExpr:
+			if selector, ok := node.Fun.(*ast.SelectorExpr); ok {
+				if receiver, ok := selector.X.(*ast.Ident); ok && receiver.Name == "os" && selector.Sel.Name == "Pipe" {
+					hasPipe = true
+				}
+			}
+		case *ast.AssignStmt:
+			for _, expression := range node.Lhs {
+				selector, ok := expression.(*ast.SelectorExpr)
+				if !ok {
+					continue
+				}
+				receiver, ok := selector.X.(*ast.Ident)
+				if ok && receiver.Name == "os" && (selector.Sel.Name == "Stdout" || selector.Sel.Name == "Stderr") {
+					hasStdioRedirect = true
+				}
+			}
+		case *ast.GoStmt:
+			hasReaderGoroutine = true
+			ast.Inspect(node.Call, func(concurrentNode ast.Node) bool {
+				call, ok := concurrentNode.(*ast.CallExpr)
+				if !ok {
+					return true
+				}
+				selector, ok := call.Fun.(*ast.SelectorExpr)
+				if ok && selector.Sel.Name == "Read" {
+					hasConcurrentRead = true
+				}
+				return true
+			})
+		}
+		return true
+	})
+	return hasPipe, hasStdioRedirect, hasReaderGoroutine, hasConcurrentRead
+}
