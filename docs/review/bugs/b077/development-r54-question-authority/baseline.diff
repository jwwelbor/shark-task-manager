+		{name: "conflicting", flags: []struct{ name, value string }{{"epic", "E01"}, {"task", "T-E01-F01-001"}}, wantErr: true},
+		{name: "valid plus explicitly empty first", flags: []struct{ name, value string }{{"epic", ""}, {"task", "T-E01-F01-001"}}, wantErr: true},
