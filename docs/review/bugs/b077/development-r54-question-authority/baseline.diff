+    receipt["worker_id"] = worker
+    if started != 1:
+        return "unverified"
+    files = list((home / "sessions").rglob("rollout-*-" + worker + ".jsonl"))
+    if len(files) != 1:
+        return "unverified"
+    providers, turns, models, efforts, completions = set(), set(), set(), set(), []
