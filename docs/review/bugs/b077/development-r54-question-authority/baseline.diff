+    request = {"provider": "openai", "model": model, "effort": "high"}
+    cmd = command_for(make_args(), request)
+
+    assert cmd[:3] == ["codex", "exec", "--json"]
+    assert cmd[cmd.index("-m") + 1] == model
+    assert cmd[cmd.index("-c") + 1] == 'model_reasoning_effort="high"'
