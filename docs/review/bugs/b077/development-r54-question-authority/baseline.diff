@@ -0,0 +1,217 @@
+package commands
+
+import (
+	"context"
+	"os"
+	"testing"
+
+	"github.com/jwwelbor/shark-task-manager/internal/models"
+	"github.com/jwwelbor/shark-task-manager/internal/services"
