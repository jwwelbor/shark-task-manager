+def _invoke_materializer(script, workflow_root, profile_path, *, environment=None):
+    return subprocess.run(
+        [
+            sys.executable,
+            str(script),
+            "--workflow-root",
+            str(workflow_root),
+            "--profile",
+            str(profile_path),
+        ],
+        text=True,
+        capture_output=True,
+        check=False,
+        env=environment,
+    )
