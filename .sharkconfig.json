{
  "color_enabled": true,
  "console_width": 95,
  "database": {
    "auth_token_file": "$SHARK_AUTH_TOKEN_FILE",
    "backend": "$SHARK_DB_BACKEND",
    "skip_migrations": true,
    "url": "$SHARK_DB_URL"
  },
  "interactive_mode": false,
  "json_output": false,
  "last_sync_time": "2026-01-16T23:22:45-06:00",
  "observability": {
    "enabled": true,
    "exporter": "otlp",
    "log_file": "./shark.log",
    "log_format": "text",
    "log_level": "debug",
    "metrics_enabled": false,
    "otlp_endpoint": "",
    "service_name": "shark",
    "tracing_enabled": false
  },
  "require_rejection_reason": true,
  "size_required_for": ["task", "feature", "epic", "bug", "change", "idea", "tech_debt"],
  "tag_required_for": ["epic"]
}
