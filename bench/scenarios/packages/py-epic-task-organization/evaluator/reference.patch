+    def tag_task(self, task_id: int, tag: str) -> Task:
+        """Attach a tag to a task, idempotently (re-tagging is a no-op)."""
+        task = self._tasks[task_id]
+        if tag not in task.tags:
+            task.tags.append(tag)
+        return task
+
+    def list_tasks(self, tag: str | None = None) -> list[Task]:
+        """List tasks, optionally filtered to those carrying `tag`.
+
+        With no filter, behavior is unchanged: every task, in insertion
+        order.
+        """
+        tasks = list(self._tasks.values())
+        if tag is None:
+            return tasks
+        return [t for t in tasks if tag in t.tags]
 
