@@ -0,0 +1,25 @@
+"""Recurrence-rule calculations for recurring tasks."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+RECURRENCE_INTERVALS = {
+    "daily": timedelta(days=1),
+    "weekly": timedelta(days=7),
+    "monthly": timedelta(days=30),
+}
+
+
+def validate_recurrence_rule(rule: str) -> None:
+    """Raise ValueError if rule is not one of the closed recurrence set."""
+    if rule not in RECURRENCE_INTERVALS:
+        raise ValueError(
+            f"recurrence_rule must be one of {sorted(RECURRENCE_INTERVALS)}, got {rule!r}"
+        )
+
+
+def next_due_date(due_date: date, rule: str) -> date:
+    """Return the next occurrence's due date, advanced by rule's interval."""
+    validate_recurrence_rule(rule)
+    return due_date + RECURRENCE_INTERVALS[rule]
