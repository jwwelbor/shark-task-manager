+    def delete_task(self, task_id: int) -> None:
+        """Remove a task permanently.
+
+        Raises TaskNotFoundError (never a bare KeyError) if task_id does not
+        exist, so callers can distinguish "not found" from any other
+        dict-shaped error.
+        """
