+// ErrNegativeFee is returned when a flat fee is negative.
+var ErrNegativeFee = errors.New("fee must not be negative")
+
 // ApplyFlatFee adds a flat, non-negative feeCents to subtotalCents and
 // returns the new total.
 func ApplyFlatFee(subtotalCents int, feeCents int) (int, error) {
+	if feeCents < 0 {
+		return 0, ErrNegativeFee
+	}
 	return subtotalCents + feeCents, nil
 }
